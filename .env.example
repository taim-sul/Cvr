PORT=3000

# ---------------------------------------------------------------
# CVR-datakilde. Vaelg: virk | cvrapi | mock
# ---------------------------------------------------------------
CVR_PROVIDER=cvrapi

# virk = officiel System-til-system adgang (Erhvervsstyrelsen).
# Skriv til cvrselvbetjening@erst.dk for brugerId + password.
VIRK_URL=http://distribution.virk.dk/cvr-permanent/virksomhed/_search
VIRK_USER=
VIRK_PASSWORD=

# cvrapi = cvrapi.dk. Kraever en identificerende User-Agent.
# Tjek deres vilkaar for kommerciel/hoej volumen brug foer produktion.
CVRAPI_URL=https://cvrapi.dk/api
CVRAPI_USER_AGENT=SmartLines CVR-kontrol - kontakt@ditdomaene.dk

# ---------------------------------------------------------------
# Momskilde. Vaelg: vies | skat | mock
# ---------------------------------------------------------------
VAT_PROVIDER=vies

# Dit EGET momsnummer. Udfyldes for at faa et consultation number
# (requestIdentifier) fra VIES - det er den juridiske kvittering.
VIES_REQUESTER_COUNTRY=DK
VIES_REQUESTER_VAT=
VIES_URL=https://ec.europa.eu/taxation_customs/vies/rest-api/check-vat-number

# skat = browserautomation mod ntse.skat.dk. Se README, afsnit "Selectors".
SKAT_URL=https://ntse.skat.dk/ntse-front/public/momsnummer/soeg

# ---------------------------------------------------------------
# Saet til false for at teste hele floedet uden Chromium (skriver .html i stedet for .pdf)
PDF_ENABLED=true

CONCURRENCY=3
REQUEST_DELAY_MS=250
MAX_RETRIES=3
REQUEST_TIMEOUT_MS=20000
MAX_UPLOAD_MB=10
